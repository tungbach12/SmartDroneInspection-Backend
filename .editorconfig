# SmartDroneInspection — whitespace rules only.
# Naming/style conventions live in docs/coding-conventions/BACKEND-CSharp.md and are enforced by code review.
# CI runs `dotnet format SmartDroneInspection.sln --verify-no-changes --no-restore`.

root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
