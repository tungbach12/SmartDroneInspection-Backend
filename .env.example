# ==============================================================================
# SmartDroneInspection - Docker Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# IMPORTANT: Generate secure random keys for production or staging environments!
# To generate a compliant 256-bit Base64 key:
#   Linux/macOS:
#     openssl rand -base64 32
#   Windows PowerShell:
#     $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=smartdroneinspection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_only_change_me
# Host port for PostgreSQL. Change this if a native PostgreSQL (or another
# container) already listens on 5432 — the stack will fail to start with
# "ports are not available". The container always listens on 5432 internally,
# so only the backend's connection is affected, not its configuration.
POSTGRES_PORT=5433
# Bind only to localhost on host machine to prevent direct external access
POSTGRES_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# 2. Object Storage (MinIO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=local_minio_admin
MINIO_ROOT_PASSWORD=local_dev_only_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=inspection-evidence
# Bind only to localhost on host machine to prevent direct external access
MINIO_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# 3. Backend Application Security & Authentication
# ------------------------------------------------------------------------------
# REQUIRED when running under 'prod' profile. Must be Base64-encoded strings (>= 32 bytes).
AUTH_JWT_SECRET=
AUTH_REFRESH_TOKEN_PEPPER=

# Set to false for internal HTTP test deployments. MUST be set to true behind HTTPS/TLS!
AUTH_SECURE_COOKIES=false

# Allowed CORS origins (comma-separated).
AUTH_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:80

# Optional: Bootstrap initial admin user on first startup
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_EMAIL=admin@smartdroneinspection.local
AUTH_BOOTSTRAP_PASSWORD=ChangeMeInProduction123!
AUTH_BOOTSTRAP_FULL_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 4. Web Application (Nginx + Frontend SPA)
# ------------------------------------------------------------------------------
# External port to publish on the host (defaults to 80)
WEB_PORT=80

# Backend port exposed on host (for mobile emulator / direct API access)
SERVER_PORT=8080
BACKEND_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# 5. Business / Feature Limits
# ------------------------------------------------------------------------------
REPORT_NARRATIVE_MAX_CHARS=10000
EVIDENCE_MAX_FILE_SIZE=10MB

# ------------------------------------------------------------------------------
# 6. Advisory AI (optional; keep exactly one image-inference provider enabled)
# ------------------------------------------------------------------------------
YOLO_INFERENCE_ENABLED=false
YOLO_INFERENCE_BASE_URL=http://localhost:8000
YOLO_INFERENCE_PREDICT_PATH=/predict
YOLO_INFERENCE_CONNECT_TIMEOUT=2s
YOLO_INFERENCE_READ_TIMEOUT=30s

# OpenAI-compatible multimodal endpoint, e.g. a locally or remotely hosted vision model.
# Store credentials only in your local .env; do not commit them.
COMPATIBLE_VISION_ENABLED=false
COMPATIBLE_VISION_BASE_URL=
COMPATIBLE_VISION_MODEL=
COMPATIBLE_VISION_API_KEY=
COMPATIBLE_VISION_TIMEOUT=60s

# Report drafting is independently configurable from image inference.
REPORT_DRAFT_ENABLED=false
REPORT_DRAFT_BASE_URL=http://localhost:11434
REPORT_DRAFT_API_KEY=
REPORT_DRAFT_MODEL=llama3
REPORT_DRAFT_TIMEOUT=60s
EVIDENCE_MAX_REQUEST_SIZE=10MB
