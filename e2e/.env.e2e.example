# Copy into an ignored run-local env file; never commit real generated values.
# The launcher generates a unique E2E_PROJECT and secure values for each run.
E2E_PROJECT=sdi-e2e-replace-with-run-id
FRONTEND_CONTEXT=../sdi-mf1-mf4-frontend
POSTGRES_DB=smartdroneinspection_e2e
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_PER_RUN
MINIO_ROOT_USER=e2e_local_user
MINIO_ROOT_PASSWORD=GENERATE_PER_RUN
MINIO_BUCKET=inspection-evidence-e2e
AUTH_JWT_SECRET=GENERATE_BASE64_SECRET_PER_RUN
AUTH_REFRESH_TOKEN_PEPPER=GENERATE_SECRET_PER_RUN
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_EMAIL=admin-e2e@example.invalid
AUTH_BOOTSTRAP_PASSWORD=GENERATE_PER_RUN
AUTH_BOOTSTRAP_FULL_NAME=E2E Platform Administrator
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
