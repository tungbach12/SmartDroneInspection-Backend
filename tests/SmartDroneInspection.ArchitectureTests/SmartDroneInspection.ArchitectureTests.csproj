    <ProjectReference Include="..\..\src\SmartDroneInspection.Infrastructure\SmartDroneInspection.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SmartDroneInspection.Api\SmartDroneInspection.Api.csproj" />
  </ItemGroup>

</Project>
